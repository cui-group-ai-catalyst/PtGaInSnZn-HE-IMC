{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cui-group-ai-catalyst/PtGaInSnZn-HE-IMC/schemas/system_manifest.schema.json",
  "title": "Bounded validation system manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "system_id",
    "status",
    "scientific_scope",
    "output_dir",
    "claim_boundary",
    "contract_catalog",
    "modules"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "system_id": {"type": "string", "minLength": 1},
    "status": {"const": "bounded-validation-demo"},
    "scientific_scope": {"type": "string", "minLength": 1},
    "output_dir": {"type": "string", "minLength": 1},
    "contract_catalog": {"type": "string", "minLength": 1},
    "claim_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "software_configurability",
        "within_manifold_interpolation",
        "binary_energy_rank_consistency",
        "new_host_or_prototype_transferability",
        "nonmetal_compound_transferability",
        "synthesizability"
      ],
      "properties": {
        "software_configurability": {"const": "demonstrated_for_bundled_inputs"},
        "within_manifold_interpolation": {"const": "validated_internal"},
        "binary_energy_rank_consistency": {"const": "observed_reference_set"},
        "new_host_or_prototype_transferability": {"const": "not_evaluated"},
        "nonmetal_compound_transferability": {"const": "not_evaluated"},
        "synthesizability": {"const": "not_predicted"}
      }
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "enabled"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {
            "enum": ["manifold_regression", "energy_backend_comparison"]
          },
          "enabled": {"type": "boolean"},
          "config_path": {"type": "string"},
          "config": {"type": "object"}
        }
      }
    }
  }
}
